# MT5 connection (copy to .env, never commit .env).
#
# Not read by any code yet: MT5Bridge takes an MT5ConnectionConfig, and with
# all fields left empty it attaches to the terminal that is already running
# and logged in -- which is how the tournament downloads history today.
# Fill these in only when wiring an unattended runner that must log in itself.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Risk parameters deliberately do NOT live here. They are in
# config/risk_rules.yaml and can only tighten the HARD_* ceilings in
# core/risk_guardrails/validator.py -- an env var must never be a way to
# loosen Shield.
